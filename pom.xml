<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.soundx</groupId>
    <artifactId>soundx</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>SoundX</name>
    <description>Soundboard de bureau pour Windows (Java Swing + javax.sound.sampled + JNativeHook)</description>

    <properties>
        <!-- Java 21 (LTS) : recommande, disponible sur Temurin/Adoptium.
             Java 17 fonctionne aussi : changer la valeur ci-dessous en 17. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <main.class>com.soundx.Main</main.class>
    </properties>

    <dependencies>
        <!-- ================================================================
             Raccourcis clavier GLOBAUX (hook natif clavier/souris).
             Fonctionne meme quand l'application n'a pas le focus.
             Depuis la 2.2.x le package est com.github.kwhat.jnativehook
             ================================================================ -->
        <dependency>
            <groupId>com.github.kwhat</groupId>
            <artifactId>jnativehook</artifactId>
            <version>2.2.2</version>
        </dependency>

        <!-- ================================================================
             Decodage MP3 branche sur javax.sound.sampled via le mecanisme
             SPI. Cet artefact tire automatiquement :
               - jlayer          (decodeur MP3 pur Java, alias "JLayer")
               - tritonus-share  (pont SPI javax.sound.sampled)
             Resultat : AudioSystem.getAudioInputStream(fichier.mp3) marche.
             ================================================================ -->
        <dependency>
            <groupId>com.googlecode.soundlibs</groupId>
            <artifactId>mp3spi</artifactId>
            <version>1.9.5.4</version>
        </dependency>

        <!-- ================================================================
             Persistance de la configuration (peripherique choisi, volume,
             raccourcis) au format JSON lisible.
             ================================================================ -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>2.11.0</version>
        </dependency>

        <!-- ================================================================
             Theme sombre moderne pour Swing (look & feel noir / rouge).
             ================================================================ -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>3.7.2</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Lancement rapide en developpement : mvn compile exec:java -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!-- Jar executable "tout-en-un" (dependances incluses).
                 ServicesResourceTransformer = INDISPENSABLE : il fusionne les
                 fichiers META-INF/services/* pour que le SPI MP3 (tritonus)
                 reste detecte a l'interieur du fat-jar. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
